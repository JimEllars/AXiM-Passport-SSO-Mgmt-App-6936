{
  "name": "@axim/passport-sdk",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "build:sdk": "vite build -c vite.sdk.config.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@axim/passport-sdk": "github:jimellars/axim-passport-sso-mgmt-app-6936#main",
    "@questlabs/react-sdk": "^2.2.92",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "4.1.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.0.8",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "dist-sdk/passport-sdk.umd.js",
  "module": "dist-sdk/passport-sdk.es.js",
  "exports": {
    ".": {
      "import": "./dist-sdk/passport-sdk.es.js",
      "require": "./dist-sdk/passport-sdk.umd.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
