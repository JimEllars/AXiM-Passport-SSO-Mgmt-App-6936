{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axim-passport-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "route": {
    "pattern": "passport.axim.us.com/api/*",
    "zone_name": "axim.us.com"
  },
  "vars": {
    "AXIM_CORE_API_URL": "https://api.axim.us.com",
    "PASSPORT_ORIGIN": "https://passport.axim.us.com",
    "FRONTEND_ORIGINS": "https://passport.axim.us.com,https://axim-passport.pages.dev",
    "ALLOWED_REDIRECT_ORIGINS": "https://nexus.axim.us.com,https://echo.axim.us.com,https://onyx.axim.us.com,https://greenmachine.axim.us.com,https://support.axim.us.com,https://asguard.axim.us.com,https://voice.axim.us.com,https://groundgame.axim.us.com,https://ceodept.axim.us.com",
    "SUPABASE_URL": "https://pvbcdndqjguzqeafhwhw.supabase.co",
    "WALLET_CHAIN_ID": "1",
    "TURNSTILE_ACTION": "passport_auth"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STATE",
        "class_name": "AuthState"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "REVOCATION_KV",
      "id": "61412cfc5af94df7896fc8432e9abf8b"
    },
    {
      "binding": "SECURITY_AUDIT_LOGS",
      "id": "a28f87960ebd4b20a0fa26ca28ecbcbd"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthState"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PASSPORT_ANALYTICS",
      "dataset": "passport_telemetry_prod"
    },
    {
      "binding": "ANALYTICS",
      "dataset": "axim_passport_telemetry"
    }
  ],
  "triggers": {
    "crons": ["0 11 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
